{
  "type": "object",
  "layout": "tabs",
  "required": [
    "datasetMode"
  ],
  "allOf": [
    {
      "title": "Jeu de données",
      "default": {
        "datasetMode": "create",
        "dataset": {
          "id": "",
          "title": ""
        }
      },
      "oneOf": [
        {
          "title": "Créer un jeu de données",
          "required": [
            "dataset"
          ],
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "create",
              "title": "Action"
            },
            "dataset": {
              "type": "object",
              "required": [
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "title": "Identifiant (laissez vide pour calculer un identifiant à partir du titre)"
                },
                "title": {
                  "type": "string",
                  "title": "Titre"
                }
              }
            }
          }
        }
      ]
    },
    {
      "title": "Paramètres",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "title": "URL source",
          "type": "string",
          "description": "Les protocoles supportés sont HTTP, HTTPS\nLes formats supportés sont .zip et .gpkg"
        },
        "idsLayers": {
          "type": "array",
          "title": "Couches à extraire",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "default": [
            1
          ],
          "description": "Les nombres à indiquer correspondent aux numéros des couches à extraire. Ne rien indiquer affichera seulement les couches disponibles sans les extraire."
        }
      }
    }
  ]
}