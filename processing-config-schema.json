{
  "type": "object",
  "layout": "tabs",
  "required": [
    "datasetMode"
  ],
  "allOf": [
    {
      "title": "Dataset mode",
      "x-i18n-title": { "fr": "Liste de jeux de données", "en": "Datasets" },
      "default": {
        "datasetMode": "list"
      },
      "properties": {
        "haveList": {
          "type": "boolean",
          "default": false,
          "layout": "none"
        }
      },
      "oneOf": [
        {
          "title": "List layers",
          "x-i18n-title": { "fr": "Lister les différentes couches", "en": "List the available layers" },
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "list",
              "title": "Action"
            }
          },
          "layout": {
            "children": [
              "datasetMode",
              {
                "markdown": "List the different layers of your file before you can create or update datasets.",
                "x-i18n-markdown": {
                  "fr": "Listez les différentes couches de votre fichier avant de pouvoir créer des jeux de données ou les mettre à jour."
                }
              },
              {
                "markdown": "**Warning:** if you use a .zip file containing .gpkg files, only the first .gpkg file found will be used.",
                "x-i18n-markdown": {
                  "fr": "**Attention :** si vous utilisez un fichier .zip contenant des fichiers .gpkg, seul le premier .gpkg trouvé sera utilisé."
                }
              }
            ]
          }
        },
        {
          "title": "Create datasets",
          "x-i18n-title": { "fr": "Créer des jeux de données" },
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "create",
              "title": "Action"
            },
            "dataset": {
              "type": "object",
              "properties": {
                "editableCreate": {
                  "type": "boolean",
                  "default": false,
                  "title": "Editable datasets",
                  "x-i18n-title": { "fr": "Jeux de données éditables" },
                  "description": "By default, file datasets are created, which are less memory-intensive but difficult to update.",
                  "x-i18n-description": { "fr": "Par défaut, on crée des jeux de données fichier, moins coûteux en mémoire, mais difficilement actualisables." }
                }
              }
            }
          },
          "layout": {
            "if": "parent.data.haveList",
            "children": [
              "datasetMode",
              "dataset",
              {
                "markdown": "Select the layers you want to add in the **File Layers** tab.",
                "x-i18n-markdown": {
                  "fr": "Sélectionnez les couches que vous voulez ajouter dans l'onglet **Couches du fichier**."
                }
              }
            ]
          }
        },
        {
          "title": "Update datasets",
          "x-i18n-title": { "fr": "Mettre à jour des jeux de données" },
          "properties": {
            "datasetMode": {
              "type": "string",
              "const": "update",
              "title": "Action"
            },
            "editableUpdate": {
              "type": "boolean",
              "default": false,
              "title": "Editable datasets",
              "x-i18n-title": { "fr": "Jeux de données éditables" },
              "description": "By default, file datasets are updated",
              "x-i18n-description": { "fr": "Par défaut, on met à jour des jeux de données fichier." }
            },
            "datasets": {
              "type": "array",
              "title": "Datasets to update",
              "x-i18n-title": { "fr": "Jeux de données à mettre à jour" },
              "layout": {
                "listEditMode": "inline"
              },
              "items": {
                "type" : "object",
                  "layout" : [
                    {
                      "children": [
                        "dataset"
                      ],
                      "cols": 4
                    },
                    {
                      "children": [
                        "layer"
                      ],
                      "cols": 4
                    },
                    {
                      "children": [
                        "forceUpdate"
                      ],
                      "cols": 3
                    }
                  ],
                "required": [
                  "dataset",
                  "layer"
                ],
                "properties": {
                  "dataset": {
                    "type": "object",
                    "title": "Existing dataset",
                    "x-i18n-title": { "fr": "Jeu de données existant" },
                    "properties": {
                      "id": {
                        "type": "string",
                        "title": "Identifier",
                        "x-i18n-title": { "fr": "Identifiant" }
                      },
                      "href": {
                        "type": "string",
                        "title": "URL"
                      },
                      "title": {
                        "type": "string",
                        "title": "Title",
                        "x-i18n-title": { "fr": "Titre" }
                      }
                    },
                    "layout": {
                      "getItems": {
                        "url": "${context.dataFairUrl}/api/v1/datasets?q={q}&select=id,title&${context.ownerFilter}&${parent.parent.parent.parent.data.editableUpdate === true ? 'rest' : 'file'}=true",
                        "itemsResults": "data.results",
                        "itemTitle": "item.title",
                        "itemKey": "item.id"
                      }
                    }
                  },
                  "layer": {
                    "type": "object",
                    "title": "Layer",
                    "x-i18n-title": { "fr": "Couche" },
                    "properties": {
                      "nb": {
                        "type": "integer",
                        "title": "Layer identifier",
                        "x-i18n-title": { "fr": "Identifiant de la couche" }
                      },
                      "name": {
                        "type": "string",
                        "title": "Layer name",
                        "x-i18n-title": { "fr": "Nom de la couche" }
                      }
                    },
                    "layout": {
                      "getItems": {
                        "expr": "parent.parent.parent.parent.data.layers || []",
                        "itemsResults": "data",
                        "itemTitle": "item.name",
                        "itemKey": "item.nb"
                      }
                    }
                  },
                  "forceUpdate": {
                    "type" : "boolean",
                    "title": "Force schema update",
                    "x-i18n-title": { "fr": "Forcer la mise à jour du schéma" }
                  }
                }
              }
            }
          },
          "layout": {
            "if": "parent.data.haveList"
          }
        }
      ]
    },
    {
      "title" : "File layers",
      "x-i18n-title": { "fr": "Couches du fichier" },
      "required": [
        "layers"
      ],
      "layout": {
        "readOnlyPropertiesMode": "show",
        "children": [
          {
            "if": "!parent.data.layers || parent.data.layers.length === 0",
            "children": [
              {
                "markdown": "**No layers detected**",
                "x-i18n-markdown": {
                  "fr": "**Aucune couche détectée**"
                }
              }
            ]
          },
          {
            "if": "parent.data.layers && parent.data.layers.length > 0",
            "children": [
              {
                "markdown": "*To update the layers, for example in the case of a new file, run the **layers list** mode again.*",
                "x-i18n-markdown": {
                  "fr": "*Pour remettre à jour les couches, en cas de nouveau fichier par exemple, exécutez de nouveau le mode **liste des couches**.*"
                }
              }
            ]
          },
          "addAllLayers",
          "tableHeader",
          "layers"
        ]
      },
      "properties": {
        "addAllLayers": {
          "type": "boolean",
          "title": "Add all the layers",
          "x-i18n-title": { "fr": "Ajouter toutes les couches" },
          "layout": {
            "if": "parent.parent.data.datasetMode === 'create'"
          }
        },
        "tableHeader": {
          "type": "object",
          "layout": [
            {
              "children": [
                "add"
              ],
              "cols": 1,
              "if": "parent.parent.parent.data.datasetMode === 'create' && parent.parent.data.addAllLayers !== true"
            },
            {
              "children": [
                "nb"
              ],
              "cols": 1
            },
            {
              "children": [
                "name"
              ],
              "cols": 4
            },
            {
              "children": [
                "lines"
              ],
              "cols": 2
            },
            {
              "children": [
                "titleEditable",
                "titleReadOnly"
              ],
              "cols": 4
            }
          ],
          "properties": {
            "add": {
              "type": "string",
              "title": "Add",
              "x-i18n-title": { "fr": "Ajouter" },
              "readOnly": true
            },
            "nb": {
              "type": "string",
              "title": "Number",
              "x-i18n-title": { "fr": "Numéro" },
              "readOnly": true
            },
            "name": {
              "type": "string",
              "title": "Layer name",
              "x-i18n-title": { "fr": "Nom de la couche" },
              "readOnly": true
            },
            "lines": {
              "type": "string",
              "title": "Nombre de lignes",
              "readOnly": true
            },
            "titleEditable": {
              "type": "string",
              "title": "Title of the corresponding dataset",
              "x-i18n-title": { "fr": "Titre du jeu de données correspondant" },
              "readOnly": true,
              "description": "By default, the dataset title corresponds to the layer name",
              "x-i18n-description": { "fr": "Par défaut, le titre du jeu de données correspond au nom de la couche" },
              "layout": {
                "if": "parent.parent.parent.parent.data.datasetMode === 'create'"
              }
            },
            "titleReadOnly": {
              "type": "string",
              "title": "Title of the corresponding dataset",
              "x-i18n-title": { "fr": "Titre du jeu de données correspondant" },
              "readOnly": true,
              "description": "By default, the dataset title corresponds to the layer name",
              "x-i18n-description": { "fr": "Par défaut, le titre du jeu de données correspond au nom de la couche" },
              "layout": {
                "if": "parent.parent.parent.parent.data.datasetMode !== 'create'"
              }
            }
          }
        },
        "layers": {
          "type": "array",
          "title": " ",
          "layout": {
            "listEditMode": "inline",
            "listActions": []
          },
          "items": {
            "type": "object",
            "layout": [
              {
                "children": [
                  "add"
                ],
                "cols": 1,
                "if": "parent.parent.parent.data.datasetMode === 'create' && parent.parent.parent.data.addAllLayers !== true"
              },
              {
                "children": [
                  "nb"
                ],
                "cols": 1
              },
              {
                "children": [
                  "name"
                ],
                "cols": 4
              },
              {
                "children": [
                  "lines"
                ],
                "cols": 2
              },
              {
                "children": [
                  "titleEditable",
                  "titleReadOnly"
                ],
                "cols": 4
              },
              {
                "children": [
                  "warningSRS"
                ],
                "cols": 6
              },
              {
                "children": [
                  "SRS"
                ],
                "cols": 6
              }
            ],
            "properties": {
              "add": {
                "type": "boolean",
                "title": " "
              },
              "nb": {
                "type": "integer",
                "readOnly": true,
                "title": " "
              },
              "name": {
                "type": "string",
                "readOnly": true,
                "title": " "
              },
              "lines": {
                "type": "integer",
                "readOnly": true,
                "title": " "
              },
              "titleEditable": {
                "type": "string",
                "title": " ",
                "layout": {
                  "if": "parent.parent.parent.parent.data.datasetMode === 'create'"
                }
              },
              "titleReadOnly": {
                "type": "string",
                "title": " ",
                "readOnly": true,
                "layout": {
                  "if": "parent.parent.parent.parent.data.datasetMode !== 'create'"
                }
              },
              "haveSRS": {
                "type": "boolean",
                "default": true,
                "title": " ",
                "readOnly": true
              },
              "warningSRS": {
                "type": "object",
                "layout": {
                  "slots": {
                    "before": "**Warning: The SRS is not defined for this layer!**",
                    "x-i18n-before": { "fr": "**Attention : Le SRS n'est pas défini pour cette couche !**" }
                  },                  
                  "if": "parent.data.haveSRS === false"
                }
              },
              "SRS": {
                "type": "string",
                "title": "SRS",
                "description": "SRS corresponds to the spatial reference system for processing geometries.",
                "x-i18n-description": { "fr": "SRS correspond au système de référence spatiale pour le traitement des géométries." },
                "examples": [
                  "EPSG:2154 - Lambert 93",
                  "EPSG:4326 - WGS 84",
                  "EPSG:3857 - Web Mercator",
                  "EPSG:4171 - RGF93",
                  "EPSG:4559 - RRAF 91 (French Antilles)",
                  "EPSG:2972 - RGFG95 (French Guiana)",
                  "EPSG:4471 - RGM04 (Mayotte)",
                  "EPSG:2975 - RGR92 (Reunion Island)"
                ],
                "x-i18n-examples": {
                  "fr": [
                    "EPSG:2154 - Lambert 93",
                    "EPSG:4326 - WGS 84",
                    "EPSG:3857 - Web Mercator",
                    "EPSG:4171 - RGF93",
                    "EPSG:4559 - RRAF 91 (Antilles françaises)",
                    "EPSG:2972 - RGFG95 (Guyane)",
                    "EPSG:4471 - RGM04 (Mayotte)",
                    "EPSG:2975 - RGR92 (La Réunion)"
                  ]
                },
                "layout": {
                  "if": "parent.data.haveSRS === false"
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "Parameters",
      "x-i18n-title": { "fr": "Paramètres" },
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "title": "Source URL",
          "x-i18n-title": { "fr": "URL source" },
          "type": "string",
          "description": "Supported protocols are HTTP and HTTPS; supported formats are .zip and .gpkg.",
          "x-i18n-description": { "fr": "Les protocoles supportés sont HTTP et HTTPS, les formats supportés sont .zip et .gpkg." }
        }
      }
    }
  ]
}